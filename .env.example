# Copy to .env and adjust. Every variable is optional; the defaults are shown.

# --- Control plane and auth (see docs/architecture.md) ---
#
# [server]/[database]/[auth] are layered with the `config` crate:
# config/default.toml -> config/{APP_ENV}.toml -> env (APP__SECTION__KEY,
# e.g. APP__AUTH__JWKS_URL) -> config/local.toml (gitignored). The env vars
# below are the override layer; config/dev.toml already sets sane local
# defaults (auth.mode = "hybrid" with the committed dev secret), so most of
# these can stay commented out for local dev.

# `dev`, `staging` or `prod`. Picks config/{APP_ENV}.toml and gates
# production refusals (auth.mode = "dev" and the committed dev HS256
# secret are both refused outside `dev`). Unset = dev.
# APP_ENV=dev

# The control-plane Postgres URL. Both this bare name and
# APP__DATABASE__URL work (dual-canonical, matching what infra's Terraform
# module injects); unset disables workspace-membership enforcement (every
# workspace id is accessible as `owner`) -- fine for local/single-tenant
# use, never for production.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lula

# auth.mode: `jwks` (default; verify against a JWKS URL -- any OIDC
# provider, Supabase included), `hs256` (shared secret, local/test only),
# `hybrid` (both, dispatched per token by its header `alg`), or `dev`
# (bypasses verification entirely: every request is DEV_USER_ID,
# overridable per-request with an `X-Dev-User: <uuid>` header, and always
# treated as aal2). `dev` only ever activates on this exact value, logs a
# loud warning, and the server refuses to start with it outside
# APP_ENV=dev. Legacy spelling; canonical is APP__AUTH__MODE.
# AUTH_MODE=dev
# Required for jwks/hybrid: the provider's JWKS URL and issuer.
# APP__AUTH__JWKS_URL=https://xyzcompany.supabase.co/auth/v1/.well-known/jwks.json
# APP__AUTH__ISSUER=https://xyzcompany.supabase.co/auth/v1
# Expected `aud` claim.
# APP__AUTH__AUDIENCE=authenticated
# Required for hs256/hybrid, local/test only. config/dev.toml already sets
# this to a committed dev value; never set it to that value outside dev.
# APP__AUTH__JWT_SECRET=
# auth.mode = dev's fixed user id.
# DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Per-workspace SQLite files live under DATA_DIR/workspaces/{id}.db,
# including the legacy/default workspace (see DATABASE_URL above, which no
# longer means a sqlite path -- a sqlite: value there is ignored with a
# warning).
DATA_DIR=data

# Hard cap on rows returned by POST /w/{ws}/queries/{id}/run, and the
# per-request timeout (the query is abandoned, not forcibly interrupted --
# see docs/architecture.md).
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_MS=5000

# --- Server ---

# Legacy; canonical is APP__SERVER__HOST / APP__SERVER__PORT (defaults
# 0.0.0.0:8080, overridden to 127.0.0.1:3000 in config/dev.toml).
BIND_ADDR=127.0.0.1:3000

# Comma-separated CORS allowlist (bearer-token API: no credentials sent).
# APP__SERVER__CORS_ORIGINS=https://app.lula.dog,http://localhost:5173

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info

# Extractor behind POST /opportunities/:id/paste: `stub` (deterministic, no
# network) or `grok` (xAI). With `grok`, XAI_API_KEY and XAI_MODEL are required.
EXTRACTOR=stub
# In production XAI_API_KEY comes from AWS Secrets Manager via ECS (the
# same `lula-api` secret that carries DATABASE_URL); this var is all the
# code ever reads.
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1

# Chat behind POST /w/{ws}/apps/:app/chat: `fake` (deterministic, no
# network; the default unless XAI_API_KEY is set) or `grok` (xAI, reuses
# XAI_API_KEY/XAI_BASE_URL above).
# CHAT_PROVIDER=fake
# Chat's model. Falls back to XAI_MODEL, then to grok-4.7 (xAI's
# recommended chat model, https://docs.x.ai/docs/models) if neither is set.
# XAI_CHAT_MODEL=grok-4.7
# USD per 1M prompt/completion tokens, for the cost estimate on each chat
# turn; unset means no estimate, never a guess. xAI's current published
# price for grok-4.7 below 200k prompt tokens is $2.00 input / $6.00
# output per 1M tokens -- never hardcoded, since prices change.
# CHAT_PRICE_INPUT_PER_1M_USD=2.00
# CHAT_PRICE_OUTPUT_PER_1M_USD=6.00

# --- Lead generation (see docs/lead-gen.md) ---

# Local stand-in for the object store: raw imported files and crawled pages
# are archived here, unchanged, before being parsed/used.
BUCKET_DIR=data/bucket

# Website-lookup backend for `cargo run -- enrich`: `stub` (deterministic, no
# network) or `google` (Places Text Search, New). With `google`,
# GOOGLE_PLACES_API_KEY is required.
PLACES=stub
# GOOGLE_PLACES_API_KEY=

# Site-crawl backend, also used by `enrich`: `stub` (deterministic, no
# network) or `http` (real fetches, respecting robots.txt and the limits below).
CRAWLER=stub
CRAWL_MAX_PAGES=4
CRAWL_TIMEOUT_SECS=10
CRAWL_MAX_BYTES=1000000

# Lead-scoring backend for `cargo run -- classify`: `stub` (deterministic, no
# network) or `grok` (xAI, reuses XAI_API_KEY/XAI_MODEL/XAI_BASE_URL above).
CLASSIFIER=stub

# target_profiles.min_fit_score for the default profile `cargo run -- seed`
# creates for Jack, if none exists yet.
LEAD_MIN_FIT_SCORE=50
