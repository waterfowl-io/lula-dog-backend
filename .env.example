# Copy to .env and adjust. Every variable is optional; the defaults are shown.

# --- Control plane and auth (see docs/architecture.md) ---

# Supabase Postgres: profiles, workspaces, membership, app definitions,
# saved queries, schema catalog. Migrations in migrations/control/ apply on
# every start. Unset disables workspace-membership enforcement (every
# workspace id is accessible as `owner`) -- fine for local/single-tenant
# use, never for production.
# CONTROL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/lula

# Auth mode: `supabase` (default) verifies a Supabase Auth JWT; `dev`
# bypasses verification entirely (every request is DEV_USER_ID, overridable
# per-request with an `X-Dev-User: <uuid>` header). Only ever activates on
# this exact value, logs a loud warning, never run in production.
AUTH_MODE=supabase
# Required when AUTH_MODE=supabase: the Supabase project URL. JWTs are
# verified against its JWKS (${SUPABASE_URL}/auth/v1/.well-known/jwks.json,
# ES256/RS256) and issuer (${SUPABASE_URL}/auth/v1).
# SUPABASE_URL=https://xyzcompany.supabase.co
# Expected `aud` claim.
SUPABASE_JWT_AUD=authenticated
# Legacy HS256 fallback (older Supabase projects); unset rejects HS256
# tokens outright.
# SUPABASE_JWT_SECRET=
# How long a fetched JWKS is cached before refetching (a `kid` the cache
# doesn't have triggers an immediate refetch regardless).
JWKS_CACHE_TTL_SECS=300
# AUTH_MODE=dev's fixed user id.
# DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Per-workspace SQLite files live under DATA_DIR/workspaces/{id}.db.
DATA_DIR=data

# Hard cap on rows returned by POST /w/{ws}/queries/{id}/run, and the
# per-request timeout (the query is abandoned, not forcibly interrupted --
# see docs/architecture.md).
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_MS=5000

# --- Data plane ---

# SQLite database file for the legacy/default workspace
# (00000000-0000-0000-0000-000000000000); every other workspace lives under
# DATA_DIR instead. Created on first start; migrations apply on every start.
DATABASE_URL=sqlite://lula.db

# Address the API listens on.
BIND_ADDR=127.0.0.1:3000

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info

# Extractor behind POST /opportunities/:id/paste: `stub` (deterministic, no
# network) or `grok` (xAI). With `grok`, XAI_API_KEY and XAI_MODEL are required.
EXTRACTOR=stub
# XAI_API_KEY=
# XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1

# --- Lead generation (see docs/lead-gen.md) ---

# Local stand-in for the object store: raw imported files and crawled pages
# are archived here, unchanged, before being parsed/used.
BUCKET_DIR=data/bucket

# Website-lookup backend for `cargo run -- enrich`: `stub` (deterministic, no
# network) or `google` (Places Text Search, New). With `google`,
# GOOGLE_PLACES_API_KEY is required.
PLACES=stub
# GOOGLE_PLACES_API_KEY=

# Site-crawl backend, also used by `enrich`: `stub` (deterministic, no
# network) or `http` (real fetches, respecting robots.txt and the limits below).
CRAWLER=stub
CRAWL_MAX_PAGES=4
CRAWL_TIMEOUT_SECS=10
CRAWL_MAX_BYTES=1000000

# Lead-scoring backend for `cargo run -- classify`: `stub` (deterministic, no
# network) or `grok` (xAI, reuses XAI_API_KEY/XAI_MODEL/XAI_BASE_URL above).
CLASSIFIER=stub

# target_profiles.min_fit_score for the default profile `cargo run -- seed`
# creates for Jack, if none exists yet.
LEAD_MIN_FIT_SCORE=50
